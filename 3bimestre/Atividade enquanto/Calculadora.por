programa {
  funcao inicio() {
    inteiro opcao
    real n1,n2,resultado

    faca{
      escreva("\n Calculadora\n")
      escreva("1-Soma\n")
      escreva("2-Subtração\n")
      escreva("3-Multiplicação\n")
      escreva("4-Divisão\n")
      escreva("0-Sair\n")
      escreva("Escolher uma opção:")
      leia(opcao)

    }enquanto(opcao !=0)
  }
}
